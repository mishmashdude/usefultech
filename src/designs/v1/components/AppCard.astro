---
// An app card for grids (categories pages, "more apps"). The whole card links to the app page.
import Icon from '../../../components/Icon.astro';
import AppIcon from './AppIcon.astro';
import { categoriesOf, type App } from '../data/apps';
import { to } from '../base';

interface Props {
  app: App;
  morph?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { app, morph = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const cats = categoriesOf(app);
const external = app.link.href.startsWith('http');
---

<article class="app-card" data-tone={app.tone}>
  <div class="art" aria-hidden="true">
    <AppIcon app={app} size={86} morph={morph} />
    {app.highlights.map((h, i) => <span class="sticker" style={`--i:${i}`}>{h}</span>)}
  </div>
  <div class="body">
    <div class="title-row">
      <Heading class="name"><a href={to(`/apps/${app.slug}`)} class="stretch">{app.name}</a></Heading>
      {app.status === 'soon' && <span class="soon">coming soon</span>}
    </div>
    <p class="kind">{app.kind} · {app.platforms.join(' + ')}</p>
    <p class="tagline">{app.tagline}</p>
    <div class="foot">
      <span class="tags">
        {
          cats.map((c) => (
            <span class="chip" data-tone={c.tone}>
              <Icon name={c.icon} />
              {c.name}
            </span>
          ))
        }
      </span>
      <a
        class="btn btn--tone btn--sm get"
        href={app.link.href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
      >
        {app.link.label}
        <Icon name="ph:arrow-up-right-bold" class="icon--nudge-out" />
        {external && <span class="sr-only">(opens in a new tab)</span>}
      </a>
    </div>
  </div>
</article>

<style>
  .app-card {
    --lift: 0px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      0 calc(4px + var(--lift)) 0 0 var(--line-2);
    transform: translateY(calc(-1 * var(--lift)));
    transition:
      transform 0.22s var(--ease-spring),
      box-shadow 0.22s var(--ease-spring);
    overflow: hidden;
  }

  .app-card:hover {
    --lift: 4px;
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--tone-deep) 40%, transparent),
      0 calc(4px + var(--lift)) 0 0 var(--tone-deep);
  }

  .art {
    position: relative;
    display: grid;
    place-items: center;
    height: 190px;
    background-color: var(--tone-soft);
    background-image: radial-gradient(
      color-mix(in oklab, var(--tone) 55%, transparent) 1.2px,
      transparent 1.5px
    );
    background-size: 18px 18px;
    overflow: hidden;
  }

  .art :global(.app-icon) {
    transition: transform 0.35s var(--ease-spring);
  }

  .app-card:hover .art :global(.app-icon) {
    transform: rotate(-6deg) scale(1.06);
  }

  .sticker {
    position: absolute;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 850;
    font-size: 0.85rem;
    white-space: nowrap;
    box-shadow: 0 3px 0 var(--tone-deep);
  }

  .sticker:nth-child(2) {
    top: 22px;
    left: 18px;
    rotate: -6deg;
  }

  .sticker:nth-child(3) {
    right: 16px;
    top: 50%;
    rotate: 5deg;
  }

  .sticker:nth-child(4) {
    left: 30px;
    bottom: 20px;
    rotate: 3deg;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 20px;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .name {
    font-size: 1.75rem;
    letter-spacing: -0.04em;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .stretch:focus-visible {
    outline: none;
  }

  .stretch:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .soon {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 850;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .kind {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--tone-text);
  }

  .tagline {
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .get {
    position: relative;
    z-index: 1;
    margin-bottom: 4px;
    margin-left: auto;
  }
</style>
