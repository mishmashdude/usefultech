---
// The usefultech mark: a magnet-shaped "u" (useful things stick), plus the wordmark.
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { size = 34, wordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`--logo-size:${size}px`}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9.5" fill="var(--brand)"></rect>
    <path
      d="M10.4 7.2v9.1a5.6 5.6 0 0 0 11.2 0V7.2"
      fill="none"
      stroke="#fff7ec"
      stroke-width="5"
      stroke-linecap="butt"></path>
    <rect x="7.9" y="6.2" width="5" height="4.2" rx="1" fill="#1f1c17"></rect>
    <rect x="19.1" y="6.2" width="5" height="4.2" rx="1" fill="#1f1c17"></rect>
  </svg>
  {wordmark && <span class="logo-word">usefultech</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo-mark {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
    filter: drop-shadow(0 3px 0 var(--brand-deep));
    transition: transform 0.3s var(--ease-spring);
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: calc(var(--logo-size) * 0.72);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }

  :global(a:hover) > .logo .logo-mark {
    transform: rotate(-8deg) scale(1.06);
  }
</style>
