---
import Logo from './Logo.astro';
import { apps } from '../data/apps';
import { categories } from '../data/categories';
import { site } from '../data/site';
import { to } from '../base';

const year = new Date().getFullYear();
const letters = [...'usefultech'];
const tones = ['sky', 'lime', 'lilac', 'butter', 'pink', 'mint'];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={to('/')} aria-label="usefultech home"><Logo size={36} /></a>
        <p>apps that support your life.<br />made by friends, with care.</p>
      </div>
      <nav class="footer-cols" aria-label="footer">
        <div>
          <p class="footer-head">apps</p>
          <ul role="list">
            {apps.map((a) => (
              <li>
                <a href={to(`/apps/${a.slug}`)}>{a.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="footer-head">categories</p>
          <ul role="list">
            {categories.map((c) => (
              <li>
                <a href={to(`/categories/${c.slug}`)}>{c.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="footer-head">usefultech</p>
          <ul role="list">
            <li><a href={to('/categories')}>explore</a></li>
            <li><a href={to('/#makers')}>makers</a></li>
            <li><a href={`mailto:${site.email}`}>say hi</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-base">
      <p>© {year} usefultech</p>
      <p>made with care, by friends</p>
    </div>
  </div>
  <p class="wordmark" aria-hidden="true">
    {letters.map((l, i) => <span data-tone={tones[i % tones.length]}>{l}</span>)}
  </p>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(64px, 8vw, 104px);
    border-top: 1px solid var(--line);
  }

  .footer-top {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1.6fr;
    }
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .footer-brand a {
    justify-self: start;
    border-radius: 12px;
  }

  .footer-brand p {
    color: var(--ink-2);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .footer-head {
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.05rem;
  }

  .footer-cols ul {
    display: grid;
    gap: 6px;
  }

  .footer-cols a {
    color: var(--ink-2);
    border-radius: 4px;
    transition: color 0.15s;
  }

  .footer-cols a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--ink-3);
  }

  .wordmark {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 4vw, 48px);
    margin-bottom: -0.2em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(4rem, 19.2vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--paper-3);
    user-select: none;
  }

  .wordmark span {
    display: inline-block;
    transition:
      transform 0.35s var(--ease-spring),
      color 0.2s;
  }

  .wordmark span:hover {
    color: var(--tone);
    transform: translateY(-0.08em) rotate(-4deg);
  }
</style>
