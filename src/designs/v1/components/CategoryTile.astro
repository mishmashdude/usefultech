---
// A big flat tile linking to a category page.
import Icon from '../../../components/Icon.astro';
import AppIcon from './AppIcon.astro';
import { appsIn } from '../data/apps';
import type { Category } from '../data/categories';
import { to } from '../base';

interface Props {
  category: Category;
  current?: boolean;
}

const { category: c, current = false } = Astro.props;
const list = appsIn(c.slug);
---

<a
  class:list={['cat-tile', { 'is-current': current }]}
  href={to(`/categories/${c.slug}`)}
  data-tone={c.tone}
  aria-current={current ? 'page' : undefined}
>
  <span class="cat-top">
    <span class="cat-icon"><Icon name={c.icon} /></span>
    <span class="cat-arrow"><Icon name="ph:arrow-up-right-bold" /></span>
  </span>
  <span class="cat-name">{c.name}</span>
  <span class="cat-blurb">{c.blurb}</span>
  <span class="cat-foot">
    <span class="cat-apps">{list.map((a) => <AppIcon app={a} size={30} />)}</span>
    <span class="cat-count">{list.length} app{list.length === 1 ? '' : 's'}</span>
  </span>
</a>

<style>
  .cat-tile {
    --lift: 0px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 22px 22px 20px;
    border-radius: var(--radius-lg);
    background: var(--tone-soft);
    color: var(--tone-ink);
    box-shadow: 0 calc(4px + var(--lift)) 0 0 color-mix(in oklab, var(--tone-soft), var(--tone-deep) 32%);
    transform: translateY(calc(-1 * var(--lift)));
    transition:
      transform 0.22s var(--ease-spring),
      box-shadow 0.22s var(--ease-spring);
  }

  .cat-tile:hover {
    --lift: 4px;
  }

  .cat-tile:active {
    transform: translateY(4px);
    box-shadow: 0 0 0 0 transparent;
    transition-duration: 0.06s;
  }

  .cat-tile:focus-visible {
    border-radius: var(--radius-lg);
  }

  .cat-tile.is-current {
    box-shadow:
      inset 0 0 0 3px var(--tone-deep),
      0 4px 0 0 var(--tone-deep);
  }

  .cat-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .cat-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--tone);
    color: var(--tone-on);
    box-shadow: inset 0 -3px 0 color-mix(in oklab, var(--tone-deep) 55%, transparent);
  }

  .cat-icon :global(.icon) {
    width: 27px;
    height: 27px;
  }

  .cat-arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--tone) 35%, transparent);
    transition: transform 0.25s var(--ease-spring);
  }

  .cat-arrow :global(.icon) {
    width: 17px;
    height: 17px;
  }

  .cat-tile:hover .cat-arrow {
    transform: rotate(45deg);
  }

  .cat-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.85rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .cat-blurb {
    opacity: 0.85;
  }

  .cat-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
  }

  .cat-apps {
    display: flex;
  }

  .cat-apps :global(.app-icon) {
    margin-right: -8px;
    border: 2px solid var(--tone-soft);
    box-sizing: content-box;
  }

  .cat-count {
    margin-left: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.92rem;
  }
</style>
