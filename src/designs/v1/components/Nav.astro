---
import Logo from './Logo.astro';
import Icon from '../../../components/Icon.astro';
import { to } from '../base';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const links = [
  { href: to('/#apps'), label: 'apps', key: 'apps' },
  { href: to('/categories'), label: 'categories', key: 'categories' },
  { href: to('/#makers'), label: 'makers', key: 'makers' },
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href={to('/')} class="nav-brand" aria-label="usefultech home"><Logo size={32} /></a>

    <nav class="nav-links" aria-label="primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.key === current ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-end">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="switch to dark mode">
        <Icon name="ph:moon-fill" class="when-light" />
        <Icon name="ph:sun-fill" class="when-dark" />
      </button>
      <a class="btn btn--brand btn--sm nav-cta" href={to('/categories')}>
        explore apps <Icon name="ph:arrow-right-bold" class="icon--nudge-right" />
      </a>
      <details class="menu" data-menu>
        <summary aria-label="menu"><Icon name="ph:list-bold" /></summary>
        <div class="menu-panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="btn btn--brand btn--sm" href={to('/categories')}>explore apps</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    transition:
      background-color 0.25s,
      box-shadow 0.25s;
  }

  .nav[data-scrolled] {
    background: color-mix(in oklab, var(--paper) 84%, transparent);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 1px 0 var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 74px;
  }

  .nav-brand {
    border-radius: 12px;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }

  .nav-links a {
    padding: 8px 14px;
    border-radius: 11px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--ink);
    background: var(--paper-2);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--ink-2);
    transition:
      color 0.15s,
      background-color 0.15s,
      transform 0.3s var(--ease-spring);
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--paper-2);
    transform: rotate(-12deg);
  }

  .theme-toggle :global(.icon) {
    width: 21px;
    height: 21px;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.when-light),
  :global(:root:not([data-theme='dark'])) .theme-toggle :global(.when-dark) {
    display: none;
  }

  .nav-cta {
    margin-bottom: 0;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--btn-neutral);
    box-shadow: 0 4px 0 var(--btn-neutral-deep);
    cursor: pointer;
    list-style: none;
    transition:
      transform 0.15s var(--ease-spring),
      box-shadow 0.15s var(--ease-spring);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary:active,
  .menu[open] summary {
    transform: translateY(4px);
    box-shadow: 0 0 0 var(--btn-neutral-deep);
  }

  .menu summary :global(.icon) {
    width: 22px;
    height: 22px;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 14px);
    display: grid;
    gap: 2px;
    min-width: 230px;
    padding: 10px;
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-float);
    animation: menu-in 0.25s var(--ease-spring);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }

  .menu-panel a:not(.btn) {
    padding: 11px 14px;
    border-radius: 12px;
    font-family: var(--font-display);
    font-weight: 850;
    font-size: 1.15rem;
  }

  .menu-panel a:not(.btn):hover {
    background: var(--paper-2);
  }

  .menu-panel .btn {
    margin-top: 6px;
  }

  @media (max-width: 760px) {
    .nav-links,
    .nav-cta {
      display: none;
    }

    .nav-end {
      margin-left: auto;
    }

    .menu {
      display: block;
    }
  }
</style>
