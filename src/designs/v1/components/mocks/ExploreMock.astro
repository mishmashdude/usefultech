---
// The "explore" window on the hero desktop: a little Finder for browsing apps by category.
// Filtering + opening apps is handled by the desktop script (MacDesktop.astro).
import Icon from '../../../../components/Icon.astro';
import AppIcon from '../AppIcon.astro';
import { apps } from '../../data/apps';
import { categories } from '../../data/categories';
import { to } from '../../base';
---

<div class="explore" data-explore>
  <nav class="side" aria-label="explore by category">
    <p class="side-label">usefultech</p>
    <button type="button" class="side-item" data-explore-filter="all" data-label="all apps" aria-pressed="true">
      <Icon name="ph:squares-four-fill" />all apps
    </button>
    <p class="side-label">categories</p>
    {
      categories.map((c) => (
        <button
          type="button"
          class="side-item"
          data-explore-filter={c.slug}
          data-label={c.name}
          data-tone={c.tone}
          aria-pressed="false"
        >
          <span class="dot" />
          {c.name}
        </button>
      ))
    }
  </nav>
  <div class="main">
    <div class="toolbar">
      <span class="arrows" aria-hidden="true"><Icon name="ph:caret-left-bold" /><Icon name="ph:caret-right-bold" /></span>
      <b data-explore-title>all apps</b>
      <span class="count" data-explore-count>{apps.length} apps</span>
    </div>
    <ul class="grid" role="list">
      {
        apps.map((app) => (
          <li data-cats={app.categories.join(' ')}>
            <button type="button" class="item" data-open={app.slug}>
              <AppIcon app={app} size={56} />
              <span class="name">{app.name}</span>
              <span class="kind">{app.kind}</span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="pathbar">
      <span class="path"><Icon name="ph:folder-simple-fill" />usefultech › <span data-explore-title>all apps</span></span>
      <a href={to('/categories')} data-explore-link>open the categories page <Icon name="ph:arrow-up-right-bold" /></a>
    </div>
  </div>
</div>

<style>
  .explore {
    display: flex;
    height: 100%;
  }

  .side {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 150px;
    padding: 10px 8px;
    background: var(--win-side);
    border-right: 1px solid var(--win-line);
  }

  .side-label {
    padding: 8px 8px 4px;
    font-size: 11px;
    font-weight: 650;
    color: var(--win-ink-2);
  }

  .side-item {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: 7px;
    text-align: left;
  }

  .side-item:hover {
    background: var(--win-hover);
  }

  .side-item[aria-pressed='true'] {
    background: color-mix(in oklab, var(--brand) 22%, transparent);
    font-weight: 650;
  }

  .side-item :global(.icon) {
    width: 15px;
    height: 15px;
    color: var(--brand-text);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 0 1.5px var(--tone-deep) inset;
  }

  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--win-line);
  }

  .arrows {
    display: flex;
    gap: 6px;
    color: var(--win-ink-2);
  }

  .arrows :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .count {
    margin-left: auto;
    font-size: 12px;
    color: var(--win-ink-2);
  }

  .grid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    align-content: start;
    gap: 6px;
    padding: 14px;
    overflow: auto;
  }

  .item {
    display: grid;
    justify-items: center;
    gap: 3px;
    width: 100%;
    padding: 10px 4px 8px;
    border-radius: 10px;
    text-align: center;
    transition: background-color 0.15s;
  }

  .item:hover {
    background: var(--win-hover);
  }

  .item :global(.app-icon) {
    margin-bottom: 4px;
    transition: transform 0.25s var(--ease-spring);
  }

  .item:hover :global(.app-icon) {
    transform: translateY(-3px) rotate(-3deg);
  }

  .name {
    font-weight: 650;
  }

  .kind {
    font-size: 11px;
    color: var(--win-ink-2);
  }

  .pathbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 32px;
    padding: 0 14px;
    border-top: 1px solid var(--win-line);
    font-size: 11.5px;
    color: var(--win-ink-2);
    white-space: nowrap;
  }

  .path,
  .pathbar a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }

  .pathbar :global(.icon) {
    width: 12px;
    height: 12px;
  }

  .pathbar a {
    font-weight: 650;
    color: var(--brand-text);
    border-radius: 4px;
  }

  .pathbar a:hover {
    text-decoration: underline;
  }

  @container (max-width: 480px) {
    .explore {
      flex-direction: column;
    }

    .side {
      flex-direction: row;
      width: auto;
      padding: 8px;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--win-line);
      scrollbar-width: none;
    }

    .side-label,
    .path,
    .toolbar {
      display: none;
    }

    .side-item {
      flex: none;
    }
  }
</style>
