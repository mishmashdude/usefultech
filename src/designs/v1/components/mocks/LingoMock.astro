---
// lingo (working name): translate + listen + phrasebook.
import Icon from '../../../../components/Icon.astro';

const phrases = ['directions', 'ordering food', 'small talk', 'help!'];
---

<div class="lingo" data-mock="lingo" data-tone="butter">
  <div class="head">
    <p class="title">lingo</p>
    <span class="round" aria-hidden="true"><Icon name="ph:clock-counter-clockwise-bold" /></span>
  </div>

  <div class="langs">
    <span class="lang" data-lang="a">english</span>
    <button type="button" class="swap" data-swap aria-label="swap languages">
      <Icon name="ph:arrows-left-right-bold" />
    </button>
    <span class="lang" data-lang="b">japanese</span>
  </div>

  <div class="card card--from">
    <p class="text" data-text="a">where’s the nearest train station?</p>
    <div class="card-foot m-muted" aria-hidden="true">
      <Icon name="ph:camera-fill" />
      <Icon name="ph:clipboard-text-fill" />
      <span class="count">34 / 500</span>
    </div>
  </div>

  <div class="card card--to">
    <p class="text text--big" data-text="b" lang="ja">最寄りの駅はどこですか？</p>
    <p class="say" data-say>mo-yo-ri no e-ki wa do-ko de-su ka?</p>
    <div class="card-foot">
      <button type="button" class="m-btn listen" data-listen aria-label="listen to the translation">
        <Icon name="ph:speaker-high-fill" />
        <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      </button>
      <span class="slow" aria-hidden="true">0.75×</span>
      <span class="tools" aria-hidden="true"><Icon name="ph:copy-bold" /><Icon name="ph:star-fill" /></span>
    </div>
  </div>

  <div class="phrasebook" aria-hidden="true">
    <p class="label">phrasebook</p>
    <div class="chips">{phrases.map((p) => <span>{p}</span>)}</div>
  </div>

  <div class="dock-bar" aria-hidden="true">
    <span class="side-btn"><Icon name="ph:camera-fill" /></span>
    <span class="mic"><Icon name="ph:microphone-fill" /></span>
    <span class="side-btn"><Icon name="ph:chats-circle-fill" /></span>
  </div>
</div>

<style>
  .lingo {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    height: 100%;
    padding: 3.3em 1.1em 1.4em;
    background: var(--win-bg);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.55em;
    letter-spacing: -0.045em;
  }

  .round {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: var(--win-field);
  }

  .round :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  .langs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5em;
  }

  .lang {
    display: grid;
    place-items: center;
    height: 2.4em;
    border-radius: 0.8em;
    background: var(--win-field);
    font-weight: 650;
  }

  .swap {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border-radius: 50%;
    background: var(--butter);
    color: var(--butter-on);
    box-shadow: 0 0.2em 0 var(--butter-deep);
    transition: transform 0.15s var(--ease-spring);
  }

  .swap :global(.icon) {
    width: 1.15em;
    height: 1.15em;
    transition: rotate 0.45s var(--ease-spring);
  }

  .swap.is-flipped :global(.icon) {
    rotate: 180deg;
  }

  .swap:active {
    transform: translateY(0.2em);
    box-shadow: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding: 0.9em 1em;
    border-radius: 1.1em;
  }

  .card--from {
    background: var(--win-side);
    box-shadow: inset 0 0 0 1px var(--win-line);
  }

  .card--to {
    min-height: 9em;
    background: var(--butter-soft);
    color: var(--butter-ink);
  }

  .text {
    font-size: 1.12em;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .text--big {
    font-size: 1.3em;
  }

  .say {
    font-size: 0.85em;
    font-style: italic;
    opacity: 0.8;
  }

  .card-foot {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: auto;
  }

  .card-foot :global(.icon) {
    width: 1.15em;
    height: 1.15em;
  }

  .count {
    margin-left: auto;
    font-size: 0.75em;
  }

  .listen {
    height: 2.2em;
    padding: 0 0.8em;
    border-radius: 999px;
  }

  .wave {
    display: inline-flex;
    align-items: center;
    gap: 0.14em;
    height: 1em;
  }

  .wave i {
    width: 0.15em;
    height: 0.3em;
    border-radius: 1em;
    background: currentColor;
  }

  .listen.is-playing .wave i {
    animation: wave 0.7s ease-in-out infinite;
  }

  .wave i:nth-child(2) {
    animation-delay: -0.15s !important;
  }

  .wave i:nth-child(3) {
    animation-delay: -0.3s !important;
  }

  .wave i:nth-child(4) {
    animation-delay: -0.45s !important;
  }

  .wave i:nth-child(5) {
    animation-delay: -0.6s !important;
  }

  @keyframes wave {
    0%,
    100% {
      height: 0.25em;
    }
    50% {
      height: 1em;
    }
  }

  .slow {
    font-size: 0.8em;
    font-weight: 700;
  }

  .tools {
    display: flex;
    gap: 0.6em;
    margin-left: auto;
  }

  .phrasebook {
    margin-top: auto;
  }

  .label {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--win-ink-2);
    margin-bottom: 0.4em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .chips span {
    padding: 0.3em 0.75em;
    border-radius: 999px;
    background: var(--win-field);
    font-size: 0.82em;
    font-weight: 600;
  }

  .dock-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4em;
  }

  .side-btn {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: var(--win-field);
  }

  .side-btn :global(.icon) {
    width: 1.2em;
    height: 1.2em;
  }

  .mic {
    display: grid;
    place-items: center;
    width: 3.8em;
    height: 3.8em;
    border-radius: 50%;
    background: var(--butter);
    color: var(--butter-on);
    box-shadow: 0 0.3em 0 var(--butter-deep);
  }

  .mic :global(.icon) {
    width: 1.6em;
    height: 1.6em;
  }
</style>

<script>
  const pairs = {
    a: { lang: 'english', text: 'where’s the nearest train station?' },
    b: { lang: 'japanese', text: '最寄りの駅はどこですか？', say: 'mo-yo-ri no e-ki wa do-ko de-su ka?' },
  };

  document.querySelectorAll<HTMLElement>('[data-mock="lingo"]').forEach((root) => {
    const swap = root.querySelector<HTMLButtonElement>('[data-swap]');
    const listen = root.querySelector<HTMLButtonElement>('[data-listen]');
    const langA = root.querySelector<HTMLElement>('[data-lang="a"]');
    const langB = root.querySelector<HTMLElement>('[data-lang="b"]');
    const textA = root.querySelector<HTMLElement>('[data-text="a"]');
    const textB = root.querySelector<HTMLElement>('[data-text="b"]');
    const say = root.querySelector<HTMLElement>('[data-say]');
    let flipped = false;
    let playTimer: number | undefined;

    swap?.addEventListener('click', () => {
      flipped = !flipped;
      swap.classList.toggle('is-flipped', flipped);
      const from = flipped ? pairs.b : pairs.a;
      const to = flipped ? pairs.a : pairs.b;
      if (langA) langA.textContent = from.lang;
      if (langB) langB.textContent = to.lang;
      if (textA) {
        textA.textContent = from.text;
        textA.lang = flipped ? 'ja' : 'en';
      }
      if (textB) {
        textB.textContent = to.text;
        textB.lang = flipped ? 'en' : 'ja';
      }
      if (say) say.hidden = flipped;
    });

    listen?.addEventListener('click', () => {
      listen.classList.add('is-playing');
      window.clearTimeout(playTimer);
      playTimer = window.setTimeout(() => listen.classList.remove('is-playing'), 2400);
    });
  });
</script>
