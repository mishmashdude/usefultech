---
// let's rally: search bar, venue list with free courts, and a map of venues.
import Icon from '../../../../components/Icon.astro';

const venues = [
  { name: 'camperdown tennis', area: 'camperdown', free: 6, kind: 'tennis', pin: [26, 60] },
  { name: 'atc badminton alexandria', area: 'alexandria', free: 5, kind: 'badminton', pin: [42, 84] },
  { name: 'kirribilli tennis centre', area: 'north sydney', free: 3, kind: 'tennis', pin: [58, 30] },
  { name: 'lane cove tennis club', area: 'longueville', free: 5, kind: 'tennis', pin: [24, 30] },
  { name: 'white city tennis', area: 'paddington', free: 0, kind: 'tennis', pin: [76, 62] },
];
---

<div class="rally" data-mock="rally" data-tone="lime">
  <div class="search" aria-hidden="true">
    <span class="logo">let’s rally</span>
    <span class="seg"><small>location</small>sydney, 2000</span>
    <span class="seg"><small>day</small>thu 9 oct</span>
    <span class="seg seg--opt"><small>court time</small>1 hr+</span>
    <span class="seg seg--opt"><small>time of day</small>evening</span>
    <span class="seg seg--icon"><Icon name="ph:funnel-simple-bold" />filters</span>
  </div>

  <div class="main">
    <div class="list">
      <div class="list-head">
        <b>venues ({venues.length})</b>
        <span class="m-muted" aria-hidden="true"><Icon name="ph:x-bold" /></span>
      </div>
      <div class="field" aria-hidden="true"><Icon name="ph:magnifying-glass-bold" />search venues…</div>
      <div class="toggles">
        <button type="button" class="m-pill" aria-pressed="true" data-toggle>on map ({venues.length})</button>
        <button type="button" class="m-pill" aria-pressed="false" data-toggle>favourites (2)</button>
      </div>
      <ul class="venues" role="list">
        {
          venues.map((v, i) => (
            <li>
              <button type="button" class="venue" data-venue={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="v-ico" data-kind={v.kind}>
                  <Icon name={v.kind === 'badminton' ? 'ph:feather-fill' : 'ph:court-basketball-fill'} />
                </span>
                <span class="v-txt">
                  <b>{v.name}</b>
                  <small>
                    {v.area}
                    <span class:list={['free', { none: !v.free }]}>{v.free ? `${v.free} courts` : 'none free'}</span>
                  </small>
                </span>
                <Icon name="ph:caret-right-bold" class="chev" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="map" aria-hidden="true">
      <svg class="map-art" viewBox="0 0 100 100" preserveAspectRatio="none">
        <rect width="100" height="100" fill="var(--map-land)"></rect>
        <path
          d="M0 0h100v16c-10 6-22-2-32 4s-20 2-28-2-18 6-26 2S4 14 0 18Z"
          fill="var(--map-water)"></path>
        <rect x="64" y="70" width="18" height="16" rx="3" fill="var(--map-park)"></rect>
        <rect x="8" y="40" width="12" height="9" rx="2" fill="var(--map-park)"></rect>
        <g fill="none" stroke="var(--map-road)" stroke-linecap="round">
          <path d="M0 52 100 46" stroke-width="5" vector-effect="non-scaling-stroke"></path>
          <path d="M48 20 44 100" stroke-width="5" vector-effect="non-scaling-stroke"></path>
          <path d="M0 76c30-6 50 6 100-2" stroke-width="4" vector-effect="non-scaling-stroke"></path>
          <path d="M70 18c-4 20 4 40 14 82" stroke-width="4" vector-effect="non-scaling-stroke"></path>
        </g>
        <g fill="none" stroke="var(--map-road-2)" stroke-width="1.5">
          <path
            d="M0 34h100M0 64h100M0 90h100M16 18v82M32 22v78M60 20v80M88 16v84"
            vector-effect="non-scaling-stroke"></path>
        </g>
      </svg>
      {
        venues.map((v, i) => (
          <span class:list={['pin', { 'is-active': i === 0 }]} data-pin={i} style={`left:${v.pin[0]}%;top:${v.pin[1]}%`}>
            <i data-kind={v.kind}>
              <Icon name={v.kind === 'badminton' ? 'ph:feather-fill' : 'ph:court-basketball-fill'} />
            </i>
            <span>
              <b>{v.name}</b>
              <small class:list={{ none: !v.free }}>{v.free ? `${v.free} courts free` : 'none available'}</small>
            </span>
          </span>
        ))
      }
      <span class="zoom"><Icon name="ph:plus-bold" /><Icon name="ph:minus-bold" /></span>
    </div>
  </div>
</div>

<style>
  .rally {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--map-land);
  }

  .search {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    height: 46px;
    margin: 10px 12px 0;
    padding: 0 8px 0 16px;
    border-radius: 999px;
    background: var(--win-bg);
    box-shadow:
      0 0 0 1px var(--win-line),
      0 6px 16px -8px rgb(0 0 0 / 0.25);
    white-space: nowrap;
    overflow: hidden;
  }

  .logo {
    margin-right: 10px;
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: 16px;
    letter-spacing: -0.05em;
    color: var(--lime-text);
  }

  .seg {
    display: grid;
    padding: 0 14px;
    border-left: 1px solid var(--win-line);
    font-size: 12px;
    line-height: 1.25;
  }

  .seg small {
    font-size: 10px;
    font-weight: 700;
  }

  .seg--icon {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .seg--icon :global(.icon) {
    width: 14px;
    height: 14px;
  }

  .main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(200px, 38%) 1fr;
    margin-top: 10px;
  }

  .list {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 12px 10px;
    background: var(--win-bg);
    border-top-right-radius: 16px;
    box-shadow: 4px 0 18px -10px rgb(0 0 0 / 0.3);
    overflow: hidden;
  }

  .list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
    font-size: 13px;
  }

  .list-head :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 10px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--win-line);
    color: var(--win-ink-2);
    font-size: 12px;
  }

  .field :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .toggles {
    display: flex;
    gap: 6px;
  }

  .toggles .m-pill {
    height: 26px;
    font-size: 11.5px;
  }

  .venues {
    display: grid;
    gap: 2px;
  }

  .venue {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 6px;
    border-radius: 10px;
    text-align: left;
    transition: background-color 0.15s;
  }

  .venue:hover {
    background: var(--win-side);
  }

  .venue[aria-pressed='true'] {
    background: var(--lime-soft);
  }

  .v-ico,
  .pin i {
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #4c84f5;
    color: #fff;
  }

  .v-ico {
    width: 30px;
    height: 30px;
  }

  [data-kind='badminton'] {
    background: #7b5cf0;
  }

  .v-ico :global(.icon) {
    width: 15px;
    height: 15px;
  }

  .v-txt {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }

  .v-txt b {
    font-size: 12.5px;
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .v-txt small {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--win-ink-2);
    white-space: nowrap;
  }

  .free {
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--mint-soft);
    color: var(--mint-ink);
    font-weight: 650;
  }

  .free.none {
    background: var(--win-field);
    color: var(--win-ink-2);
  }

  .venue :global(.chev) {
    width: 11px;
    height: 11px;
    color: var(--win-ink-2);
  }

  .map {
    position: relative;
    overflow: hidden;
  }

  .map-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pin {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 5px;
    border-radius: 10px;
    background: var(--win-bg);
    box-shadow: 0 3px 10px -2px rgb(0 0 0 / 0.22);
    white-space: nowrap;
    translate: -50% -50%;
    transition:
      scale 0.25s var(--ease-spring),
      background-color 0.2s;
  }

  .pin i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }

  .pin i :global(.icon) {
    width: 10px;
    height: 10px;
  }

  .pin span {
    display: grid;
    line-height: 1.15;
  }

  .pin b {
    font-size: 11px;
    font-weight: 650;
  }

  .pin small {
    font-size: 10px;
    font-weight: 650;
    color: var(--mint-text);
  }

  .pin small.none {
    color: var(--win-ink-2);
  }

  .pin.is-active {
    z-index: 2;
    scale: 1.1;
    background: var(--lime);
    color: var(--lime-on);
    box-shadow: 0 3px 0 var(--lime-deep);
  }

  .pin.is-active small {
    color: var(--lime-on);
  }

  .zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    gap: 1px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--win-line);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
  }

  .zoom :global(.icon) {
    box-sizing: content-box;
    width: 12px;
    height: 12px;
    padding: 6px;
    background: var(--win-bg);
  }

  @container (max-width: 640px) {
    .seg--opt {
      display: none;
    }
  }

  @container (max-width: 520px) {
    .main {
      grid-template-columns: 1fr;
    }

    .map {
      display: none;
    }

    .list {
      border-radius: 16px 16px 0 0;
    }

    .seg:not(.seg--icon) + .seg:not(.seg--icon) {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mock="rally"]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLButtonElement>('[data-venue]')];
    const pins = [...root.querySelectorAll<HTMLElement>('[data-pin]')];

    rows.forEach((row) => {
      row.addEventListener('click', () => {
        rows.forEach((r) => r.setAttribute('aria-pressed', String(r === row)));
        pins.forEach((p) => p.classList.toggle('is-active', p.dataset.pin === row.dataset.venue));
      });
    });

    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        toggles.forEach((t) => t.setAttribute('aria-pressed', String(t === toggle)));
      });
    });
  });
</script>
