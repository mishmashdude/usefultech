---
// The conscious glyph: a little scallop shell.
// Fill: --glyph-fill (falls back to currentColor). Ridges: --glyph-detail (falls back to --tone).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class:list={['icon', 'shell-glyph', className]}
  aria-hidden="true"
  focusable="false"
>
  <g style="fill: var(--glyph-fill, currentColor)">
    <path
      d="M12 20.4 3.6 11.2A2.6 2.6 0 0 1 5.1 6.6 2.8 2.8 0 0 1 9.4 3.9a2.8 2.8 0 0 1 5.2 0 2.8 2.8 0 0 1 4.3 2.7 2.6 2.6 0 0 1 1.5 4.6Z"
    ></path>
    <path d="M8.9 18.4h6.2l1 2.9H7.9Z"></path>
  </g>
  <g
    fill="none"
    stroke-width="1.35"
    stroke-linecap="round"
    style="stroke: var(--glyph-detail, var(--tone, #fff))"
  >
    <path d="M12 18.2 6.4 8.4"></path>
    <path d="M12 18.2 9.9 6.1"></path>
    <path d="M12 18.2 14.1 6.1"></path>
    <path d="M12 18.2 17.6 8.4"></path>
  </g>
</svg>
