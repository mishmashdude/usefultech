---
import '@fontsource-variable/geist';
import '../styles/global.css';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DesignSwitcher from '../../../components/DesignSwitcher.astro';
import { root } from '../../../lib/paths';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** which nav item is current */
  current?: string;
  /** pages without a full-bleed hero get room for the floating nav */
  padTop?: boolean;
}

const { title, description = site.description, current, padTop = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f3f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${root}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'dark' : 'light';

        // registered in the head so it runs before the new page is snapshotted
        // these fire on the window, and they do not bubble
        window.addEventListener('pagereveal', (e) => {
          if (!e.viewTransition) return;
          root.classList.add('vt');
          // PageRevealEvent.activation is missing in some Chromium builds; the
          // Navigation API has the same record once the new page is revealed.
          const fromUrl = (e.activation ?? window.navigation?.activation)?.from?.url;
          if (!fromUrl) return;
          const slug = new URL(fromUrl).pathname.match(/\/apps\/([^/]+)\/?$/)?.[1];
          if (!slug) return;
          const card = document.querySelector(`[data-app-stage="${CSS.escape(slug)}"]`);
          if (!(card instanceof HTMLElement)) return;
          card.style.setProperty('view-transition-name', `app-stage-${slug}`);
          card.style.setProperty('view-transition-class', 'app-stage');
        });

        window.addEventListener('pageswap', (e) => {
          const hero = document.querySelector('[data-app-hero]');
          if (!(hero instanceof HTMLElement) || !e.viewTransition) return;
          const destUrl = e.activation?.entry?.url;
          if (!destUrl) return;
          if (!new URL(destUrl).pathname.includes('/v3')) hero.style.setProperty('view-transition-name', 'none');
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link btn btn--solid btn--sm" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main" class:list={{ 'pad-top': padTop }}>
      <slot />
    </main>
    <Footer />
    <DesignSwitcher />

    <script>
      const root = document.documentElement;

      // mobile menu: close on link click / outside click
      const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
      document.addEventListener('click', (e) => {
        if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
      });

      // theme toggle (remembers your choice; otherwise follows the system)
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const syncLabels = () =>
        toggles.forEach((t) =>
          t.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'),
        );
      const setTheme = (theme: string, remember: boolean) => {
        const apply = () => {
          root.dataset.theme = theme;
          syncLabels();
        };
        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.startViewTransition(apply);
        } else {
          apply();
        }
        if (remember) {
          try {
            localStorage.setItem('theme', theme);
          } catch {}
        }
      };
      syncLabels();
      toggles.forEach((t) =>
        t.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true)),
      );
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let stored: string | null = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        if (!stored) setTheme(e.matches ? 'dark' : 'light', false);
      });

      // gentle reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // name only the card that was clicked, so the others stay in the page fade
      // and this one resizes into the app hero
      document.addEventListener(
        'click',
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const link = e.target instanceof Element ? e.target.closest('a') : null;
          if (!link || link.target === '_blank' || link.origin !== location.origin) return;
          const card = link.closest('[data-app-stage]');
          if (!(card instanceof HTMLElement)) return;
          const slug = card.dataset.appStage;
          if (!slug) return;
          card.style.setProperty('view-transition-name', `app-stage-${slug}`);
          card.style.setProperty('view-transition-class', 'app-stage');
        },
        true,
      );
    </script>
  </body>
</html>

<style>
  .pad-top {
    padding-top: 96px;
  }
</style>
