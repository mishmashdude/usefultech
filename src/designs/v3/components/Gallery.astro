---
// A horizontal, snap-scrolling strip of real screenshots, with glass arrows.
import Icon from '../../../components/Icon.astro';
import Screen from './Screen.astro';
import type { Shot } from '../data/apps';

interface Props {
  shots: Shot[];
  url?: string;
  label: string;
}

const { shots, url, label } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="track" role="region" aria-label={label} tabindex="0" data-track>
    {
      shots.map((s) => (
        <Screen
          shot={s}
          url={url}
          class={`item item--${s.kind}`}
          sizes={s.kind === 'browser' ? '(min-width: 760px) 760px, 88vw' : '(min-width: 760px) 270px, 62vw'}
        />
      ))
    }
  </div>
  {
    shots.length > 1 && (
      <div class="controls">
        <button type="button" class="arrow glass" data-dir="-1" aria-label="Previous screenshot">
          <Icon name="ph:caret-left" />
        </button>
        <button type="button" class="arrow glass" data-dir="1" aria-label="Next screenshot">
          <Icon name="ph:caret-right" />
        </button>
      </div>
    )
  }
</div>

<style>
  .gallery {
    position: relative;
  }

  .track {
    display: flex;
    gap: 16px;
    padding: 6px max(var(--gutter), calc((100vw - var(--container)) / 2)) 40px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline-offset: -4px;
    border-radius: var(--r-card);
  }

  .track > :global(.item) {
    flex: none;
    scroll-snap-align: start;
  }

  .track > :global(.item--phone),
  .track > :global(.item--store) {
    width: clamp(220px, 62vw, 270px);
  }

  .track > :global(.item--browser) {
    width: min(760px, 88vw);
    align-self: flex-start;
  }

  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    width: min(100% - 2 * var(--gutter), var(--container));
    margin: -8px auto 0;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
    transition: transform 0.25s var(--ease);
  }

  .arrow:active {
    transform: scale(0.94);
  }

  .arrow :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const controls = gallery.querySelector<HTMLElement>('.controls');
    const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-dir]');
    if (!track) return;

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      // nothing to scroll (wide screens): no arrows
      if (controls) controls.hidden = max <= 0;
      buttons.forEach((b) => {
        b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max;
      });
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const item = track.querySelector<HTMLElement>('.item');
        const step = (item?.offsetWidth ?? 280) + 16;
        track.scrollBy({ left: Number(b.dataset.dir) * step, behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>
