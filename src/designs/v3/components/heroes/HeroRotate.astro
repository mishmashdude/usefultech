---
// Hero option B: a dark card where the last word cycles through what the
// apps help with (travels, game, focus…) and the matching category lights up.
import Icon from '../../../../components/Icon.astro';
import CategoryChips from '../CategoryChips.astro';
import RotatingHeadline from '../RotatingHeadline.astro';
import { apps } from '../../data/apps';
import { to } from '../../base';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage">
    <div class="content">
      <RotatingHeadline />
      <p class="sub rise" style="--d: 160ms">{apps.length} small apps, each made by a friend.</p>
      <div class="actions rise" style="--d: 240ms">
        <a class="btn btn--solid btn--lg" href="#apps">Explore apps <Icon name="ph:arrow-down" /></a>
        <a class="btn btn--glass btn--lg glass" href={to('/categories')}>Browse categories</a>
      </div>
      <CategoryChips rise delay={320} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 10px var(--gutter) 0;
  }

  /* a dark island in light mode: the same tokens, flipped */
  .stage {
    --ink: #f2f2ef;
    --ink-2: #b9b9b3;
    --ink-3: #8d8d87;
    --bg: #0e0e0d;
    --focus: #f2f2ef;
    --glass: rgb(255 255 255 / 0.07);
    --glass-strong: rgb(255 255 255 / 0.12);
    --glass-rim: rgb(255 255 255 / 0.16);
    --glass-spec: rgb(255 255 255 / 0.32);
    --glass-shadow: 0 14px 34px -14px rgb(0 0 0 / 0.8), 0 2px 6px -3px rgb(0 0 0 / 0.5);
    display: grid;
    place-items: center;
    min-height: clamp(560px, 78svh, 800px);
    padding: 128px clamp(16px, 4vw, 48px) 64px;
    border-radius: 40px;
    background:
      radial-gradient(120% 70% at 50% -10%, #3a3a37 0%, rgb(58 58 55 / 0) 60%),
      radial-gradient(60% 50% at 50% 115%, #24241f 0%, rgb(36 36 31 / 0) 70%),
      #0e0e0d;
    color: var(--ink);
  }

  :global(:root[data-theme='dark']) .stage {
    background:
      radial-gradient(120% 70% at 50% -10%, #2e2e2c 0%, rgb(46 46 44 / 0) 60%),
      #141413;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .stage :global(.glass)::before {
    opacity: 0.3;
  }

  .content {
    display: grid;
    justify-items: center;
    gap: 26px;
    max-width: 1100px;
    text-align: center;
  }

  .sub {
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .actions .btn--solid:hover :global(.icon) {
    transform: translateY(2px);
  }

  @media (max-width: 720px) {
    .stage {
      min-height: 0;
      padding: 116px 16px 36px;
      border-radius: 32px;
    }

    .actions {
      width: 100%;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
