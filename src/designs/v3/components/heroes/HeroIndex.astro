---
// Hero option D: a short headline with the actions beside it, then the
// categories as a giant index. Hovering a category shows one of its apps.
import Icon from '../../../../components/Icon.astro';
import AppIcon from '../AppIcon.astro';
import Screen from '../Screen.astro';
import { apps, appsIn } from '../../data/apps';
import { categories } from '../../data/categories';
import { to } from '../../base';

const items = categories.map((c) => {
  const list = appsIn(c.slug);
  // the app to preview: one that calls this category home, else any
  const lead = apps.find((a) => a.categories[0] === c.slug) ?? list[0];
  return { ...c, list, lead };
});
---

<section class="hero" aria-labelledby="hero-title" data-index-hero>
  <div class="top">
    <div class="intro">
      <p class="label rise">usefultech · {apps.length} apps · made by friends</p>
      <h1 id="hero-title" class="headline rise" style="--d: 60ms">Apps that support your life.</h1>
    </div>
    <div class="actions rise" style="--d: 140ms">
      <a class="btn btn--solid btn--lg" href="#apps">Explore apps <Icon name="ph:arrow-down" /></a>
      <a class="btn btn--glass btn--lg glass" href={to('/categories')}>Browse categories</a>
    </div>
  </div>

  <ul class="index" role="list" aria-label="Categories">
    {
      items.map((c, i) => (
        <li class="rise" style={`--d:${220 + i * 60}ms`}>
          <a href={to(`/categories/${c.slug}`)} data-preview={c.slug}>
            <span class="name">{c.name}</span>
            <span class="count">
              {c.list.length}
              <span class="sr-only"> {c.list.length === 1 ? 'app' : 'apps'}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* follows the pointer over the index (mouse only) */}
  <div class="preview" aria-hidden="true" data-preview-card>
    {
      items.map((c) => (
        <figure class:list={['pv', `pv--${c.lead?.screens[0] ? c.lead.frame : 'icon'}`]} data-for={c.slug}>
          {c.lead?.screens[0] ? (
            <Screen shot={c.lead.screens[0]} url={c.lead.url} eager sizes={c.lead.frame === 'browser' ? '340px' : '190px'} />
          ) : (
            c.lead && (
              <div class="pv-icon">
                <AppIcon app={c.lead} size={88} />
              </div>
            )
          )}
          <figcaption class="glass">{c.list.map((a) => a.name).join(' · ')}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .hero {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    padding: 150px 0 12px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line-2);
  }

  .intro {
    display: grid;
    gap: 16px;
  }

  .headline {
    max-width: 11ch;
    font-size: clamp(2.3rem, 1rem + 3.8vw, 4.6rem);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .actions .btn--solid:hover :global(.icon) {
    transform: translateY(2px);
  }

  /* the index: giant words that wrap like a sentence */
  .index {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    padding-top: 20px;
    font-size: clamp(3.4rem, 0.6rem + 9vw, 10.5rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .index a {
    display: inline-flex;
    align-items: flex-start;
    border-radius: 0.06em;
    transition: opacity 0.35s var(--ease);
  }

  /* hovering one word quiets the rest */
  .index:has(a:hover) a:not(:hover) {
    opacity: 0.25;
  }

  .count {
    margin: 0.34em 0 0 0.1em;
    font-size: 0.18em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  /* the floating preview */
  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0;
    scale: 0.92;
    transition:
      opacity 0.25s var(--ease),
      scale 0.4s var(--ease);
  }

  .preview[data-show] {
    opacity: 1;
    scale: 1;
  }

  /* stretch, not start: the screen frame sizes itself from its container */
  .pv {
    position: absolute;
    left: 28px;
    bottom: 28px;
    display: none;
    gap: 10px;
  }

  .pv[data-on] {
    display: grid;
  }

  .pv--phone {
    width: 190px;
  }

  .pv--browser {
    width: 340px;
  }

  .pv-icon {
    justify-self: start;
    padding: 22px;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shot-shadow);
  }

  .pv figcaption {
    justify-self: start;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 120px;
    }

    .actions {
      width: 100%;
    }

    .actions .btn {
      flex: 1 1 auto;
    }

    .index {
      flex-direction: column;
      gap: 2px;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .preview {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-index-hero]');
  const card = hero?.querySelector<HTMLElement>('[data-preview-card]');

  if (hero && card && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;

    // ease the card towards the pointer
    const place = () => {
      cx += (x - cx) * (reduce ? 1 : 0.2);
      cy += (y - cy) * (reduce ? 1 : 0.2);
      card.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(place) : 0;
    };

    hero.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      if (!raf) raf = requestAnimationFrame(place);
    });

    hero.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((link) => {
      link.addEventListener('pointerenter', (e) => {
        if (!card.hasAttribute('data-show')) {
          // appear where the pointer is, not where it last was
          x = cx = e.clientX;
          y = cy = e.clientY;
          card.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
        }
        card.querySelectorAll<HTMLElement>('.pv').forEach((pv) =>
          pv.toggleAttribute('data-on', pv.dataset.for === link.dataset.preview),
        );
        card.setAttribute('data-show', '');
      });
      link.addEventListener('pointerleave', () => card.removeAttribute('data-show'));
    });
  }
</script>
