---
// Hero option A: one big centred line over a slow, monochrome "liquid"
// backdrop, with the actions and the five categories right under it.
import '@fontsource/instrument-serif/latin-400-italic.css';
import Icon from '../../../../components/Icon.astro';
import CategoryChips from '../CategoryChips.astro';
import LiquidStage from '../LiquidStage.astro';
import { apps } from '../../data/apps';
import { to } from '../../base';
---

<section class="hero" aria-labelledby="hero-title">
  <LiquidStage>
    <div class="content">
      <p class="kicker glass rise">{apps.length} apps · made by friends</p>
      <h1 id="hero-title" class="headline">
        <span class="line" style="--n: 0"><span>Apps that support</span></span>
        <span class="line" style="--n: 1"><span>your <em>life.</em></span></span>
      </h1>
      <div class="actions rise" style="--d: 300ms">
        <a class="btn btn--solid btn--lg" href="#apps">Explore apps <Icon name="ph:arrow-down" /></a>
        <a class="btn btn--glass btn--lg glass" href={to('/categories')}>Browse categories</a>
      </div>
      <CategoryChips rise delay={380} />
    </div>
  </LiquidStage>
</section>

<style>
  .hero {
    padding: 10px var(--gutter) 0;
  }

  .content {
    display: grid;
    justify-items: center;
    gap: 28px;
    max-width: 1100px;
    text-align: center;
  }

  .kicker {
    padding: 8px 15px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  .headline {
    font-size: clamp(3.1rem, 0.9rem + 7.4vw, 8.6rem);
    font-weight: 600;
    letter-spacing: -0.062em;
    line-height: 0.9;
  }

  /* each line rises out of a mask */
  .line {
    display: block;
    overflow: hidden;
    padding: 0 0.08em 0.12em;
    margin-bottom: -0.12em;
  }

  .line > span {
    display: inline-block;
    animation: line-up 1.1s var(--ease) both;
    animation-delay: calc(var(--n) * 110ms + 60ms);
  }

  @keyframes line-up {
    from {
      transform: translateY(110%);
    }
  }

  .headline em {
    font-family: var(--serif);
    font-size: 1.1em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }

  .actions .btn--solid:hover :global(.icon) {
    transform: translateY(2px);
  }

  @media (max-width: 720px) {
    .content {
      gap: 24px;
    }

    .actions {
      width: 100%;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
