---
// Temporary: a pill in the bottom-right corner for flipping between hero options.
import { heroes, type HeroSlug } from './heroes';
import { to } from '../../base';

interface Props {
  current: HeroSlug;
}

const { current } = Astro.props;
---

<nav class="hero-switch" aria-label="Hero options">
  <span class="hs-label" aria-hidden="true">Hero</span>
  {
    heroes.map((h) => (
      <a href={to(`/hero/${h.slug}`)} aria-current={h.slug === current ? 'page' : undefined} title={h.note}>
        <span class="full">{h.name}</span>
        <span class="short" aria-hidden="true">
          {h.short}
        </span>
      </a>
    ))
  }
</nav>

<style>
  .hero-switch {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(18 18 17 / 0.78);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 10px 28px -10px rgb(0 0 0 / 0.45);
    font: 600 12px/1 -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  .hs-label {
    padding: 0 8px 0 10px;
    color: rgb(255 255 255 / 0.5);
  }

  .hero-switch a {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .hero-switch a:hover {
    color: #fff;
  }

  .hero-switch a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 1px;
  }

  .hero-switch a[aria-current='page'] {
    background: #fff;
    color: #121211;
  }

  .short {
    display: none;
  }

  /* phones: letters, with the full name kept for screen readers */
  @media (max-width: 720px) {
    .hs-label {
      display: none;
    }

    .hero-switch a {
      padding: 0 9px;
    }

    .full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .short {
      display: inline;
    }
  }
</style>
