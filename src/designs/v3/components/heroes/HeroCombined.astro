---
// Hero option E, the combined one: B's rotating tagline on A's light liquid
// card, the actions, then the categories as pills. Pointing at a pill shows
// its apps (icon + short name) and says its word in the tagline. Built to
// grow: more categories just add pills and words, more apps fill the previews.
import Icon from '../../../../components/Icon.astro';
import CategoryChips from '../CategoryChips.astro';
import LiquidStage from '../LiquidStage.astro';
import RotatingHeadline from '../RotatingHeadline.astro';
import { apps } from '../../data/apps';
import { to } from '../../base';
---

<section class="hero" aria-labelledby="hero-title">
  <LiquidStage>
    <div class="content">
      <p class="kicker glass rise">{apps.length} apps · made by friends</p>
      <RotatingHeadline delay={60} />
      <div class="actions rise" style="--d: 220ms">
        <a class="btn btn--solid btn--lg" href="#apps">Explore apps <Icon name="ph:arrow-down" /></a>
        <a class="btn btn--glass btn--lg glass" href={to('/categories')}>Browse categories</a>
      </div>
      <CategoryChips rise delay={300} preview scroll />
    </div>
  </LiquidStage>
</section>

<style>
  /* above the sections below, so a preview can spill over them */
  .hero {
    position: relative;
    z-index: 2;
    padding: 10px var(--gutter) 0;
  }

  /* minmax(0, …): the sideways-scrolling pill row mustn't widen the page */
  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    min-width: 0;
    gap: 28px;
    width: 100%;
    max-width: 1100px;
    text-align: center;
  }

  .kicker {
    padding: 8px 15px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .actions .btn--solid:hover :global(.icon) {
    transform: translateY(2px);
  }

  @media (max-width: 720px) {
    .content {
      gap: 24px;
    }

    .actions {
      width: 100%;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
