---
// Lingo (working name): translate, listen, phrasebook.
import Icon from '../../../../components/Icon.astro';

const phrases = ['Directions', 'Ordering food', 'Small talk'];
---

<div class="lingo" data-mock="lingo">
  <div class="head">
    <p class="title">Translate</p>
    <span class="round" aria-hidden="true"><Icon name="ph:clock-counter-clockwise" /></span>
  </div>

  <div class="langs">
    <span class="lang" data-lang="a">English</span>
    <button type="button" class="swap" data-swap aria-label="Swap languages">
      <Icon name="ph:arrows-left-right" />
    </button>
    <span class="lang" data-lang="b">Japanese</span>
  </div>

  <div class="card card--from">
    <p class="text" data-text="a">Where’s the nearest train station?</p>
  </div>

  <div class="card card--to">
    <p class="text text--big" data-text="b" lang="ja">最寄りの駅はどこですか？</p>
    <p class="say" data-say>mo-yo-ri no e-ki wa do-ko de-su ka?</p>
    <div class="card-foot">
      <button type="button" class="m-btn listen" data-listen aria-label="Listen">
        <Icon name="ph:speaker-high" />
        <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      </button>
      <span class="tools" aria-hidden="true"><Icon name="ph:copy" /><Icon name="ph:star" /></span>
    </div>
  </div>

  <div class="phrasebook" aria-hidden="true">
    <p class="label">Phrasebook</p>
    <div class="chips">{phrases.map((p) => <span>{p}</span>)}</div>
  </div>

  <div class="dock-bar" aria-hidden="true">
    <span class="side-btn"><Icon name="ph:camera" /></span>
    <span class="mic"><Icon name="ph:microphone-fill" /></span>
    <span class="side-btn"><Icon name="ph:chats-circle" /></span>
  </div>
</div>

<style>
  .lingo {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    height: 100%;
    padding: 3.3em 1.1em 1.4em;
    background: var(--win-bg);
    color: var(--win-ink);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    font-weight: 700;
    font-size: 1.4em;
    letter-spacing: -0.035em;
  }

  .round {
    display: grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    border-radius: 50%;
    background: var(--win-field);
  }

  .round :global(.icon) {
    width: 1.05em;
    height: 1.05em;
  }

  .langs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5em;
  }

  .lang {
    display: grid;
    place-items: center;
    height: 2.3em;
    border-radius: 0.75em;
    background: var(--win-field);
    font-weight: 550;
  }

  .swap {
    display: grid;
    place-items: center;
    width: 2.3em;
    height: 2.3em;
    border-radius: 50%;
    background: var(--win-ink);
    color: var(--win-bg);
  }

  .swap :global(.icon) {
    width: 1.1em;
    height: 1.1em;
    transition: rotate 0.4s var(--ease);
  }

  .swap.is-flipped :global(.icon) {
    rotate: 180deg;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding: 0.9em 1em;
    border-radius: 1em;
  }

  .card--from {
    background: var(--win-side);
  }

  .card--to {
    min-height: 8.5em;
    background: var(--accent-soft);
  }

  .text {
    font-size: 1.08em;
    font-weight: 550;
    line-height: 1.3;
  }

  .text--big {
    font-size: 1.25em;
  }

  .say {
    font-size: 0.85em;
    color: var(--win-ink-2);
  }

  .card-foot {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: auto;
  }

  .listen {
    height: 2.1em;
    padding: 0 0.8em;
    border-radius: 999px;
  }

  .wave {
    display: inline-flex;
    align-items: center;
    gap: 0.14em;
    height: 1em;
  }

  .wave i {
    width: 0.14em;
    height: 0.3em;
    border-radius: 1em;
    background: currentColor;
  }

  .listen.is-playing .wave i {
    animation: wave 0.7s ease-in-out infinite;
  }

  .wave i:nth-child(2) {
    animation-delay: -0.15s !important;
  }

  .wave i:nth-child(3) {
    animation-delay: -0.3s !important;
  }

  .wave i:nth-child(4) {
    animation-delay: -0.45s !important;
  }

  .wave i:nth-child(5) {
    animation-delay: -0.6s !important;
  }

  @keyframes wave {
    0%,
    100% {
      height: 0.25em;
    }
    50% {
      height: 1em;
    }
  }

  .tools {
    display: flex;
    gap: 0.7em;
    margin-left: auto;
    color: var(--win-ink-2);
  }

  .tools :global(.icon) {
    width: 1.15em;
    height: 1.15em;
  }

  .phrasebook {
    margin-top: auto;
  }

  .label {
    margin-bottom: 0.4em;
    font-size: 0.8em;
    font-weight: 600;
    color: var(--win-ink-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .chips span {
    padding: 0.3em 0.75em;
    border-radius: 999px;
    background: var(--win-field);
    font-size: 0.82em;
    font-weight: 550;
  }

  .dock-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4em;
  }

  .side-btn {
    display: grid;
    place-items: center;
    width: 2.5em;
    height: 2.5em;
    border-radius: 50%;
    background: var(--win-field);
  }

  .side-btn :global(.icon) {
    width: 1.15em;
    height: 1.15em;
  }

  .mic {
    display: grid;
    place-items: center;
    width: 3.6em;
    height: 3.6em;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
  }

  .mic :global(.icon) {
    width: 1.5em;
    height: 1.5em;
  }
</style>

<script>
  const pairs = {
    a: { lang: 'English', text: 'Where’s the nearest train station?', code: 'en' },
    b: { lang: 'Japanese', text: '最寄りの駅はどこですか？', code: 'ja' },
  };

  document.querySelectorAll<HTMLElement>('[data-mock="lingo"]').forEach((root) => {
    const swap = root.querySelector<HTMLButtonElement>('[data-swap]');
    const listen = root.querySelector<HTMLButtonElement>('[data-listen]');
    const langA = root.querySelector<HTMLElement>('[data-lang="a"]');
    const langB = root.querySelector<HTMLElement>('[data-lang="b"]');
    const textA = root.querySelector<HTMLElement>('[data-text="a"]');
    const textB = root.querySelector<HTMLElement>('[data-text="b"]');
    const say = root.querySelector<HTMLElement>('[data-say]');
    let flipped = false;
    let playTimer: number | undefined;

    swap?.addEventListener('click', () => {
      flipped = !flipped;
      swap.classList.toggle('is-flipped', flipped);
      const from = flipped ? pairs.b : pairs.a;
      const to = flipped ? pairs.a : pairs.b;
      if (langA) langA.textContent = from.lang;
      if (langB) langB.textContent = to.lang;
      if (textA) {
        textA.textContent = from.text;
        textA.lang = from.code;
      }
      if (textB) {
        textB.textContent = to.text;
        textB.lang = to.code;
      }
      if (say) say.hidden = flipped;
    });

    listen?.addEventListener('click', () => {
      listen.classList.add('is-playing');
      window.clearTimeout(playTimer);
      playTimer = window.setTimeout(() => listen.classList.remove('is-playing'), 2400);
    });
  });
</script>
