---
// The Findery: the real coming-soon look (oxblood + cream) with a sneak peek.
import Icon from '../../../../components/Icon.astro';

const filters = ['All', 'Linen', 'Knits', 'Dresses', 'Bags'];
const labels = [
  { what: 'Linen sets', where: 'Byron Bay', icon: 'ph:shirt-folded', bg: '#efe6da' },
  { what: 'Slip dresses', where: 'Melbourne', icon: 'ph:dress', bg: '#e9ddce' },
  { what: 'Chunky knits', where: 'Hobart', icon: 'ph:hoodie', bg: '#f1e9df' },
  { what: 'Leather bags', where: 'Fremantle', icon: 'ph:handbag', bg: '#e5d8c6' },
];
---

<div class="findery" data-mock="findery">
  <header class="f-nav">
    <span class="f-logo">The Findery</span>
    <span class="f-est">Est. 2026</span>
  </header>

  <section class="f-hero">
    <p class="f-kicker">Coming soon</p>
    <p class="f-title">The Findery</p>
    <p class="f-sub">Discover Australia’s best emerging fashion brands.</p>
    <div class="f-wait">
      <span class="f-input" aria-hidden="true">Email address</span>
      <a class="f-join" href="https://thefindery.app/" target="_blank" rel="noopener">Join waitlist</a>
    </div>
  </section>

  <section class="f-peek">
    <div class="f-peek-head">
      <p>Sneak peek</p>
      <div class="f-filters" role="group" aria-label="Filter labels">
        {
          filters.map((f, i) => (
            <button type="button" class="f-filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter>
              {f}
            </button>
          ))
        }
      </div>
    </div>
    <ul class="f-grid" role="list">
      {
        labels.map((l) => (
          <li>
            <div class="f-tile" style={`--tile-bg:${l.bg}`}>
              <Icon name={l.icon} class="f-garment" />
              <button type="button" class="f-heart" aria-pressed="false" aria-label={`Save ${l.what}`} data-heart>
                <Icon name="ph:heart-fill" class="on" />
                <Icon name="ph:heart" class="off" />
              </button>
            </div>
            <p class="f-what">{l.what}</p>
            <p class="f-where">{l.where}</p>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .findery {
    --oxblood: #66110b;
    --cream: #f6f0e8;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--cream);
    color: #2a1512;
    overflow: hidden;
  }

  :global(:root[data-theme='dark']) .findery {
    --cream: #1f1a17;
    color: #f4ece2;
  }

  .f-nav,
  .f-hero {
    background: var(--oxblood);
    color: #f4ece2;
  }

  .f-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    padding: 0 18px;
    border-bottom: 1px solid rgb(244 236 226 / 0.16);
  }

  .f-logo,
  .f-title,
  .f-kicker,
  .f-est {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .f-logo {
    font-weight: 750;
    font-size: 13px;
  }

  .f-est {
    font-size: 10px;
    opacity: 0.7;
  }

  .f-hero {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 22px 18px 24px;
    text-align: center;
  }

  .f-kicker {
    font-size: 9.5px;
    letter-spacing: 0.18em;
    opacity: 0.7;
  }

  .f-title {
    font-weight: 750;
    font-size: clamp(24px, 6.5cqw, 38px);
    line-height: 1;
  }

  .f-sub {
    font-size: 12.5px;
    opacity: 0.85;
  }

  .f-wait {
    display: flex;
    width: min(340px, 100%);
    margin-top: 8px;
    border: 1px solid rgb(244 236 226 / 0.4);
  }

  .f-input {
    flex: 1;
    min-width: 0;
    padding: 8px 10px;
    font-size: 11.5px;
    text-align: left;
    opacity: 0.65;
    white-space: nowrap;
    overflow: hidden;
  }

  .f-join {
    flex: none;
    padding: 8px 14px;
    background: #efe6da;
    color: var(--oxblood);
    font-size: 11.5px;
    font-weight: 650;
  }

  .f-join:hover {
    background: #fff;
  }

  .f-peek {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 18px;
  }

  .f-peek-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .f-peek-head p {
    font-weight: 650;
    font-size: 12.5px;
    white-space: nowrap;
  }

  .f-filters {
    display: flex;
    gap: 4px;
    overflow: hidden;
  }

  .f-filter {
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 550;
    box-shadow: inset 0 0 0 1px rgb(102 17 11 / 0.22);
  }

  :global(:root[data-theme='dark']) .f-filter {
    box-shadow: inset 0 0 0 1px rgb(244 236 226 / 0.22);
  }

  .f-filter[aria-pressed='true'] {
    background: var(--oxblood);
    color: #f4ece2;
    box-shadow: none;
  }

  .f-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .f-tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 4.4;
    background: var(--tile-bg);
  }

  :global(:root[data-theme='dark']) .f-tile {
    background: color-mix(in oklab, var(--tile-bg) 14%, #1f1a17);
  }

  .f-tile :global(.f-garment) {
    width: 44%;
    height: 44%;
    color: var(--oxblood);
    opacity: 0.8;
  }

  :global(:root[data-theme='dark']) .f-tile :global(.f-garment) {
    color: #e0857a;
  }

  .f-heart {
    position: absolute;
    top: 5px;
    right: 5px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    color: var(--oxblood);
    transition: transform 0.2s var(--ease);
  }

  .f-heart:active {
    transform: scale(0.88);
  }

  .f-heart :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .f-heart[aria-pressed='true'] :global(.off),
  .f-heart[aria-pressed='false'] :global(.on) {
    display: none;
  }

  .f-what {
    margin-top: 6px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .f-where {
    font-size: 10.5px;
    opacity: 0.65;
  }

  @container (max-width: 560px) {
    .f-filters {
      display: none;
    }
  }

  @container (max-width: 420px) {
    .f-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .f-tile {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mock="findery"]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-heart]').forEach((heart) => {
      heart.addEventListener('click', () => {
        heart.setAttribute('aria-pressed', String(heart.getAttribute('aria-pressed') !== 'true'));
      });
    });

    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        filters.forEach((f) => f.setAttribute('aria-pressed', String(f === filter)));
      });
    });
  });
</script>
