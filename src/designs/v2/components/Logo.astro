---
// The usefultech mark (a simple "u") + wordmark.
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { size = 26, wordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`--logo-size:${size}px`}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="var(--brand)"></rect>
    <path d="M11 9.5v7a5 5 0 0 0 10 0v-7" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round"
    ></path>
  </svg>
  {wordmark && <span class="logo-word">usefultech</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .logo-mark {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
  }

  .logo-word {
    font-weight: 650;
    font-size: calc(var(--logo-size) * 0.66);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
  }
</style>
