---
// A small floating pill for flipping between the three design directions.
// Each link keeps you on the same page (e.g. /v1/apps/maple → /v3/apps/maple).
import { join, root } from '../lib/paths';

const { pathname } = Astro.url;
const path = pathname.startsWith(root) ? pathname.slice(root.length) || '/' : pathname;
const match = path.match(/^\/v(\d)(\/.*)?$/);
const current = match ? Number(match[1]) : 0;
const rest = match?.[2] ?? '/';
// pages every design has (home, categories, apps) carry over; anything else opens that design's home
const shared = /^\/(?:$|apps\/|categories(?:\/|$))/.test(rest) ? rest : '/';
const designs = [
  { n: 1, label: 'Playful' },
  { n: 2, label: 'Minimal' },
  { n: 3, label: 'Glass' },
];
---

<nav class="design-switch" aria-label="Design versions">
  <a href={join(root)} class="ds-all">Designs</a>
  {
    designs.map((d) => (
      <a href={join(`${root}/v${d.n}`, d.n === current ? rest : shared)} aria-current={d.n === current ? 'page' : undefined} title={`Design ${d.n}: ${d.label}`}>
        <span class="sr-only">Design </span>
        {d.n}
      </a>
    ))
  }
</nav>

<style>
  .design-switch {
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(18 18 17 / 0.78);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 10px 28px -10px rgb(0 0 0 / 0.45);
    font: 600 12px/1 -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  .design-switch a {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 9px;
    border-radius: 999px;
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .design-switch a:hover {
    color: #fff;
  }

  .design-switch a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 1px;
  }

  .design-switch a[aria-current='page'] {
    background: #fff;
    color: #121211;
  }

  .ds-all {
    padding: 0 10px 0 12px !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
