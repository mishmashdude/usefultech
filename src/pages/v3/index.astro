---
import { Image } from 'astro:assets';
import Base from '../../designs/v3/layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Screen from '../../designs/v3/components/Screen.astro';
import AppCard from '../../designs/v3/components/AppCard.astro';
import CategoryIndex from '../../designs/v3/components/CategoryIndex.astro';
import { apps, getApp, heroMap } from '../../designs/v3/data/apps';
import { site } from '../../designs/v3/data/site';
import { to } from '../../designs/v3/base';

// bento order + sizes; apps not listed here are added at the end
const layout: [string, 'wide' | 'tall' | 'full'][] = [
  ['maple', 'tall'],
  ['findery', 'wide'],
  ['letsrally', 'wide'],
  ['conscious', 'tall'],
  ['lingo', 'full'],
];
const placed = layout.flatMap(([slug, size]) => {
  const app = getApp(slug);
  return app ? [{ app, size }] : [];
});
const rest = apps.filter((a) => !layout.some(([s]) => s === a.slug)).map((app) => ({ app, size: 'tall' as const }));
const bento = [...placed, ...rest];

const heroPhones = [getApp('maple'), getApp('conscious')].flatMap((a) => (a?.screens[0] ? [a.screens[0]] : []));
const makers = [...new Set(apps.flatMap((a) => (a.maker ? [a.maker.name] : [])))];
---

<Base current="home" padTop={false}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-card">
      <Image class="hero-map" src={heroMap} alt="" widths={[960, 1440, 2000, 2400]} sizes="100vw" loading="eager" />
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-phones" aria-hidden="true">
        {heroPhones.map((shot, i) => <Screen shot={shot} class={`hp hp--${i + 1}`} eager sizes="(min-width: 1000px) 270px, 38vw" />)}
      </div>

      <div class="hero-copy glass rise">
        <p class="label">usefultech · {apps.length} apps · made by friends</p>
        <h1 id="hero-title" class="display">Apps that support your life.</h1>
        <div class="hero-actions">
          <a class="btn btn--solid" href="#apps">Explore apps</a>
          <a class="btn btn--glass glass" href={to('/categories')}>Categories</a>
        </div>
      </div>

      <p class="hero-note glass" aria-hidden="true"><Icon name="ph:map-pin" />Live courts in Sydney, from Let’s Rally</p>
    </div>
  </section>

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Index</p>
          <h2 id="apps-title" class="title">The apps</h2>
        </div>
        <a class="link" href={to('/categories')}>By category <Icon name="ph:arrow-right" /></a>
      </div>
      <ul class="bento" role="list">
        {
          bento.map(({ app, size }, i) => (
            <li class={`b-${size}`} data-reveal style={`--d:${(i % 2) * 90}ms`}>
              <AppCard app={app} size={size} morph />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" id="categories" aria-labelledby="cat-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Browse</p>
          <h2 id="cat-title" class="title">Categories</h2>
        </div>
      </div>
      <div data-reveal>
        <CategoryIndex />
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container about" data-reveal>
      <h2 id="about-title" class="label">About</h2>
      <p class="statement">
        A small collective of independent apps. <span class="muted">Each one built by the friend who needed it.</span>
      </p>
      {makers.length > 0 && <p class="makers">Made by {makers.join(', ')} and friends.</p>}
      <a class="btn btn--glass glass" href={`mailto:${site.email}`}>Say hi <Icon name="ph:arrow-up-right" /></a>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    padding: 10px var(--gutter) 0;
  }

  .hero-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: clamp(620px, 94svh, 940px);
    border-radius: 40px;
    background: var(--stage);
  }

  .hero-card :global(.hero-map) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(0.78) brightness(1.1) blur(0.6px);
    transform: scale(1.06);
  }

  :global(:root[data-theme='dark']) .hero-card :global(.hero-map) {
    filter: grayscale(1) invert(0.92) contrast(0.7) brightness(0.9) blur(0.6px);
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, color-mix(in oklab, var(--bg) 78%, transparent), transparent 55%),
      linear-gradient(to bottom, color-mix(in oklab, var(--bg) 55%, transparent), transparent 26%),
      color-mix(in oklab, var(--bg) 18%, transparent);
  }

  .hero-phones {
    position: absolute;
    right: clamp(16px, 6vw, 110px);
    bottom: -12%;
    display: flex;
    align-items: flex-end;
    gap: clamp(12px, 2vw, 26px);
  }

  .hero-phones :global(.hp) {
    width: clamp(150px, 19vw, 270px);
  }

  .hero-phones :global(.hp--1) {
    translate: 0 70px;
  }

  .hero-copy {
    position: absolute;
    left: clamp(12px, 2vw, 24px);
    bottom: clamp(12px, 2vw, 24px);
    display: grid;
    gap: 18px;
    max-width: min(640px, calc(100% - 24px));
    padding: clamp(22px, 3vw, 34px);
    border-radius: 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .hero-note {
    position: absolute;
    top: 86px;
    right: 22px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .hero-note :global(.icon) {
    width: 14px;
    height: 14px;
  }

  /* mid widths: lift the phones above the glass panel */
  @media (max-width: 1199px) and (min-width: 721px) {
    .hero-phones {
      top: 100px;
      bottom: auto;
      right: clamp(16px, 4vw, 48px);
    }

    .hero-phones :global(.hp) {
      width: clamp(150px, 23vw, 220px);
    }

    .hero-phones :global(.hp--1) {
      translate: 0 40px;
    }

    .hero-copy {
      max-width: 540px;
    }

    .hero-note {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero-card {
      height: clamp(620px, 90svh, 760px);
      border-radius: 32px;
    }

    .hero-phones {
      left: 50%;
      right: auto;
      top: 92px;
      bottom: auto;
      translate: -50% 0;
    }

    .hero-phones :global(.hp) {
      width: 40vw;
    }

    .hero-phones :global(.hp--1) {
      translate: 0 28px;
    }

    .hero-note {
      display: none;
    }
  }

  /* ---- apps ---- */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }

  .b-wide {
    grid-column: span 8;
  }

  .b-tall {
    grid-column: span 4;
  }

  .b-full {
    grid-column: span 12;
  }

  @media (max-width: 960px) {
    .b-wide,
    .b-tall,
    .b-full {
      grid-column: span 12;
    }
  }

  .section--tight {
    padding-top: 0;
  }

  /* ---- about ---- */
  .about {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .statement {
    max-width: 19em;
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .makers {
    color: var(--ink-3);
  }
</style>
