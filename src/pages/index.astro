---
// The root: a chooser between the three design directions.
// Once one is picked, move its pages up to the root (see README).
import { root } from '../lib/paths';

const designs = [
  {
    n: 1,
    name: 'Playful',
    href: `${root}/v1/`,
    text: 'Flat colours, pop-out buttons and a playable Mac desktop. Hand-built mock screens.',
  },
  {
    n: 2,
    name: 'Minimal',
    href: `${root}/v2/`,
    text: 'Neutral and terse, one accent per app. The same desktop, quieter.',
  },
  {
    n: 3,
    name: 'Glass',
    href: `${root}/v3/`,
    text: 'Monochrome and editorial: liquid glass, rounded cards and the apps’ real screens.',
    isNew: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>usefultech · design directions</title>
    <meta name="description" content="Three design directions for usefultech." />
    <link rel="icon" href={`${root}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">usefultech</p>
        <h1>Three directions.<br /><span>Pick one.</span></h1>
      </header>
      <ul role="list">
        {
          designs.map((d) => (
            <li>
              <a href={d.href}>
                <span class="num">Design {d.n}</span>
                <span class="name">
                  {d.name}
                  {d.isNew && <span class="new">New</span>}
                </span>
                <span class="text">{d.text}</span>
                <span class="go" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="hint">Inside each design, the pill in the bottom-left corner switches between them.</p>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    min-height: 100dvh;
    background: #f3f3f1;
    color: #0e0e0d;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: clamp(48px, 10vw, 120px) 0;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6b66;
  }

  h1 {
    margin: 0 0 clamp(32px, 6vw, 56px);
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  h1 span {
    color: #8a8a85;
  }

  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 110px 160px 1fr 32px;
    align-items: center;
    gap: 8px 20px;
    padding: 26px 28px;
    border-radius: 24px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s;
  }

  a:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.1),
      0 18px 36px -24px rgb(0 0 0 / 0.4);
  }

  a:focus-visible {
    outline: 2px solid #0e0e0d;
    outline-offset: 3px;
  }

  .num {
    font-size: 0.8125rem;
    color: #6b6b66;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .new {
    padding: 3px 9px;
    border-radius: 999px;
    background: #0e0e0d;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .text {
    color: #4c4c48;
  }

  .go {
    font-size: 1.25rem;
    transition: transform 0.25s;
  }

  a:hover .go {
    transform: translateX(4px);
  }

  .hint {
    margin-top: 28px;
    font-size: 0.875rem;
    color: #6b6b66;
  }

  @media (max-width: 720px) {
    a {
      grid-template-columns: 1fr 24px;
      padding: 22px;
    }

    .num,
    .name,
    .text {
      grid-column: 1;
    }

    .go {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
</style>
