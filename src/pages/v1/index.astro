---
import Base from '../../designs/v1/layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import MacDesktop from '../../designs/v1/components/MacDesktop.astro';
import Marquee from '../../designs/v1/components/Marquee.astro';
import AppShowcase from '../../designs/v1/components/AppShowcase.astro';
import CategoryTile from '../../designs/v1/components/CategoryTile.astro';
import GroupChat from '../../designs/v1/components/GroupChat.astro';
import { apps } from '../../designs/v1/data/apps';
import { categories } from '../../designs/v1/data/categories';
import { site } from '../../designs/v1/data/site';
import { to } from '../../designs/v1/base';

const count = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'][apps.length] ?? apps.length;
---

<Base>
  <!-- hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-top">
      <div class="hero-copy">
        <a class="badge rise" href="#apps">
          <span class="badge-dot" aria-hidden="true"></span>
          {count} apps, made by friends
          <Icon name="ph:arrow-down-bold" />
        </a>
        <h1 id="hero-title" class="display-1 rise" style="--d: 60ms">
          tech that’s<br />
          <span class="accent">actually <span class="scribble">useful.<svg
                viewBox="0 0 300 24"
                preserveAspectRatio="none"
                aria-hidden="true"><path d="M4 16C60 6 120 4 170 10s96 8 126-2"></path></svg
              ></span></span>
        </h1>
        <p class="lede rise" style="--d: 120ms">
          usefultech is a little collective of independent apps, made by friends, that make everyday life a bit easier:
          how you travel, play, focus, talk and dress.
        </p>
        <ul class="chip-row rise" role="list" style="--d: 180ms" aria-label="categories">
          {
            categories.map((c) => (
              <li>
                <a class="chip" data-tone={c.tone} href={to(`/categories/${c.slug}`)}>
                  <Icon name={c.icon} />
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hero-cta rise" style="--d: 220ms">
        <div>
          <a class="btn btn--brand" href="#apps">meet the apps <Icon name="ph:arrow-down-bold" class="icon--nudge-down" /></a>
          <p>{count} apps, one tiny team</p>
        </div>
        <div>
          <a class="btn" href={to('/categories')}>browse by category <Icon name="ph:arrow-right-bold" class="icon--nudge-right" /></a>
          <p>find an app for that</p>
        </div>
      </div>
    </div>

    <div class="container hero-desktop rise" style="--d: 300ms">
      <MacDesktop />
      <p class="psst">
        <Icon name="ph:cursor-click-fill" />
        <span class="hint-wide">psst… it’s interactive. open apps from the dock and drag the windows around.</span>
        <span class="hint-narrow">psst… it’s interactive. tap an app in the dock.</span>
      </p>
    </div>
  </section>

  <Marquee />

  <!-- the apps -->
  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><Icon name="ph:sparkle-fill" />the lineup</p>
          <h2 id="apps-title" class="display-2">small apps.<br /><span class="accent">real-life upgrades.</span></h2>
        </div>
        <p>
          every app here started as a problem one of us actually had. we built the fix, kept polishing it, and now it’s
          yours too.
        </p>
      </div>
      <div class="showcases">
        {apps.map((app, i) => <AppShowcase app={app} index={i} />)}
      </div>
    </div>
  </section>

  <!-- categories -->
  <section class="section section--tint" id="categories" aria-labelledby="cat-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker"><Icon name="ph:squares-four-fill" />explore</p>
          <h2 id="cat-title" class="display-2">explore by<br /><span class="accent">what you need.</span></h2>
        </div>
        <div class="head-side">
          <p>every app lives in one or more corners of life. pick one and see what helps.</p>
          <a class="link-arrow" href={to('/categories')}>see all categories <Icon name="ph:arrow-right-bold" /></a>
        </div>
      </div>
      <ul class="cat-grid" role="list">
        {
          categories.map((c, i) => (
            <li data-reveal style={`--d:${i * 70}ms`}>
              <CategoryTile category={c} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- makers -->
  <section class="section" id="makers" aria-labelledby="makers-title">
    <div class="container makers">
      <div class="makers-copy" data-reveal>
        <p class="kicker"><Icon name="ph:hand-waving-fill" />the people</p>
        <h2 id="makers-title" class="display-2">made by friends,<br /><span class="accent">not a big company.</span></h2>
        <p class="lede">
          usefultech isn’t a company. it’s a group chat that ships. each app is built and looked after by the person who
          needed it most, and we all help make each other’s apps better.
        </p>
        <ul class="promises" role="list">
          <li><Icon name="ph:check-circle-fill" />small, independent and focused</li>
          <li><Icon name="ph:check-circle-fill" />built for real life, not for engagement</li>
          <li><Icon name="ph:check-circle-fill" />made with care, kept up to date</li>
        </ul>
      </div>
      <GroupChat />
    </div>
  </section>

  <!-- closing call to action -->
  <section class="cta-wrap" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta" data-reveal>
        <h2 id="cta-title" class="display-2">life’s busy.<br />let’s make it easier.</h2>
        <div class="cta-actions">
          <a class="btn btn--ink" href={to('/categories')}>find your app <Icon name="ph:arrow-right-bold" class="icon--nudge-right" /></a>
          <a class="btn cta-ghost" href={`mailto:${site.email}`}>say hi <Icon name="ph:hand-waving-fill" /></a>
        </div>
        <svg class="cta-shell" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 20.4 3.6 11.2A2.6 2.6 0 0 1 5.1 6.6 2.8 2.8 0 0 1 9.4 3.9a2.8 2.8 0 0 1 5.2 0 2.8 2.8 0 0 1 4.3 2.7 2.6 2.6 0 0 1 1.5 4.6Z"
          ></path>
        </svg>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    padding-top: clamp(28px, 5vw, 64px);
  }

  .hero-top {
    display: grid;
    gap: 36px;
    align-items: end;
  }

  @media (min-width: 1000px) {
    .hero-top {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 10px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      0 3px 0 var(--line-2);
    font-family: var(--font-display);
    font-weight: 850;
    font-size: 0.95rem;
    transition: transform 0.2s var(--ease-spring);
  }

  .badge:hover {
    transform: translateY(-2px);
  }

  .badge :global(.icon) {
    width: 15px;
    height: 15px;
    color: var(--ink-3);
  }

  .badge-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--mint);
  }

  .badge-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--mint);
    opacity: 0;
    animation: ping 2.4s ease-out infinite;
  }

  @keyframes ping {
    0% {
      opacity: 0.8;
      transform: scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .scribble {
    position: relative;
    display: inline-block;
  }

  .scribble svg {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: -0.08em;
    width: 104%;
    height: 0.2em;
    overflow: visible;
  }

  .scribble path {
    fill: none;
    stroke: var(--lilac);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    vector-effect: non-scaling-stroke;
    animation: draw 0.9s 0.7s var(--ease-out) forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-cta {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, max-content);
  }

  .hero-cta > div {
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .hero-cta p {
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  @media (max-width: 560px) {
    .hero-cta {
      grid-template-columns: 1fr;
      width: 100%;
    }

    .hero-cta .btn {
      width: 100%;
    }
  }

  .hero-desktop {
    margin-top: clamp(40px, 6vw, 64px);
  }

  .psst {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 34px;
    font-size: 0.92rem;
    color: var(--ink-3);
    text-align: center;
  }

  .hint-narrow {
    display: none;
  }

  @media (max-width: 719px) {
    .hint-wide {
      display: none;
    }

    .hint-narrow {
      display: inline;
    }
  }

  .psst :global(.icon) {
    flex: none;
    width: 17px;
    height: 17px;
    color: var(--brand);
  }

  /* ---- apps ---- */
  .showcases {
    display: grid;
    gap: clamp(96px, 12vw, 168px);
  }

  /* ---- categories ---- */
  .head-side {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .head-side p {
    color: var(--ink-2);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 18px;
  }

  /* ---- makers ---- */
  .makers {
    display: grid;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  @media (min-width: 980px) {
    .makers {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    }
  }

  .makers-copy .lede {
    margin-top: 22px;
  }

  .promises {
    display: grid;
    gap: 10px;
    margin-top: 26px;
  }

  .promises li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.08rem;
  }

  .promises :global(.icon) {
    width: 22px;
    height: 22px;
    color: var(--mint-text);
  }

  /* ---- closing cta ---- */
  .cta-wrap {
    padding-bottom: clamp(72px, 9vw, 120px);
  }

  .cta {
    position: relative;
    display: grid;
    gap: 30px;
    justify-items: start;
    padding: clamp(36px, 6vw, 72px);
    border-radius: var(--radius-xl);
    background: var(--brand);
    color: var(--on-brand);
    overflow: hidden;
    box-shadow: 0 10px 0 0 var(--brand-deep);
  }

  .cta h2 {
    position: relative;
    z-index: 1;
  }

  .cta-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .cta-ghost {
    --bg: #fff3e8;
    --fg: #1f1c17;
    --edge: #d2b49c;
  }

  .cta-shell {
    position: absolute;
    right: -4%;
    bottom: -18%;
    width: clamp(220px, 34vw, 420px);
    height: auto;
    fill: rgb(255 255 255 / 0.16);
    rotate: -14deg;
  }
</style>
